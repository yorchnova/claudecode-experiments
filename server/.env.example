# Copia este archivo a .env y rellena los valores para activar la IA.

# Proveedor: "mock" (por defecto, sin IA) o "claude"
AI_PROVIDER=mock

# Necesaria solo si AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Opcional: modelo de Claude a usar (por defecto claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Puerto del backend (por defecto 3001)
# PORT=3001
